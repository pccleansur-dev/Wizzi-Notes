# ─── Wizzi Note — Variables de entorno ───────────────────────────────────────
# Copia este archivo como ".env" y completa las claves que necesites.
# Solo configura las del proveedor que vayas a usar.

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Tamaño máximo de archivo en MB (opcional, por defecto 25)
MAX_UPLOAD_MB=25

# Motor de transcripción local (la interfaz permite cambiarlo por solicitud)
ASR_PROVIDER=whisper
ASR_LANGUAGE=es-ES
NEMOTRON_URL=http://localhost:9010

# Modo GPU (opcional): permite dormir/despertar Nemotron desde la app y desde accesos directos.
# NEMOTRON_AGENT_URL por defecto = host de NEMOTRON_URL, puerto 9011. Usar tokens largos y aleatorios (32+ caracteres).
NEMOTRON_AGENT_URL=
NEMOTRON_AGENT_TOKEN=
GPU_CONTROL_TOKEN=

# Google Gemini — https://aistudio.google.com/
GEMINI_API_KEY="tu_clave_gemini_aqui"

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY="tu_clave_openai_aqui"

# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY="tu_clave_anthropic_aqui"

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID="tu_client_id_aqui"
GOOGLE_CLIENT_SECRET="tu_client_secret_aqui"
APP_URL="http://localhost:3000"

# Emails permitidos para login (separados por coma, vacío = cualquiera)
ALLOWED_EMAILS=""
